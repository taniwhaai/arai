{
  "_comment": "Run in a fresh project containing exactly tests/fixtures/card_a_alembic/CLAUDE.md after arai scan. See docs/rule-testing.md. Subject checks are case-sensitive; decisions describe effective policy, not native delivery or host trust.",
  "scenarios": [
    {
      "name": "Write under alembic matches the Alembic rule",
      "hook": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "alembic/versions/001_example.py",
          "content": ""
        }
      },
      "expect": {
        "matches_subject": ["Alembic"],
        "min_matches": 1,
        "decision": "deny"
      }
    },
    {
      "name": "Unrelated Write has no match",
      "hook": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "app/example.py",
          "content": ""
        }
      },
      "expect": {
        "does_not_match_subject": ["Alembic"],
        "max_matches": 0,
        "decision": "allow"
      }
    },
    {
      "name": "Read of an existing migration file is silent (tool is in the skip list)",
      "hook": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Read",
        "tool_input": {
          "file_path": "alembic/versions/001_example.py"
        }
      },
      "expect": {
        "max_matches": 0,
        "decision": "allow"
      }
    }
  ]
}
